{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["react", "typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "env": {
        "browser": true,
        "es2024": true
    },
    "ignorePatterns": ["dist"],
    "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/jsx-no-target-blank": "off",
        "react/no-unknown-property": "off"
    }
}
